+// ───────────────────────────────────────────────────────────────────────────
+// carsh: HCI ACL data path over the bulk endpoints (A2DP media + L2CAP).
+// ───────────────────────────────────────────────────────────────────────────
+
+boolean CUSBBluetoothDevice::SendHCIData (const void *pBuffer, unsigned nLength)
+{
+	assert (m_pEndpointBulkOut != 0);
+
+	// Blocking bulk OUT (called from the BTstack run-loop task, not an IRQ).
+	return GetHost ()->Transfer (m_pEndpointBulkOut, (void *) pBuffer, nLength) >= 0;
+}
+
+void CUSBBluetoothDevice::RegisterHCIDataHandler (TBTHCIDataHandler *pHandler)
+{
+	m_pDataHandler = pHandler;
+	assert (m_pDataHandler != 0);
+
+	StartDataRequest ();
+}
+
+boolean CUSBBluetoothDevice::StartDataRequest (void)
+{
+	assert (m_pEndpointBulkIn != 0);
+	assert (m_pACLBuffer != 0);
+
+	CUSBRequest *pURB = new CUSBRequest (m_pEndpointBulkIn, m_pACLBuffer, BT_ACL_BUFFER_SIZE);
+	assert (pURB != 0);
+
+	pURB->SetCompletionRoutine (DataCompletionStub, 0, this);
+
+	return GetHost ()->SubmitAsyncRequest (pURB);
+}
+
+void CUSBBluetoothDevice::DataCompletionRoutine (CUSBRequest *pURB)
+{
+	assert (pURB != 0);
+
+	boolean bRestart = TRUE;
+
+	if (pURB->GetStatus () != 0)
+	{
+		if (   m_pDataHandler != 0
+		    && pURB->GetResultLength () > 0)
+		{
+			(*m_pDataHandler) (m_pACLBuffer, pURB->GetResultLength ());
+		}
+	}
+	else
+	{
+		CLogger::Get ()->Write (FromBluetooth, LogWarning, "ACL request failed");
+
+		bRestart = FALSE;
+	}
+
+	delete pURB;
+
+	if (   bRestart
+	    && !StartDataRequest ())
+	{
+		CLogger::Get ()->Write (FromBluetooth, LogError, "Cannot restart ACL request");
+	}
+}
+
+void CUSBBluetoothDevice::DataCompletionStub (CUSBRequest *pURB, void *pParam, void *pContext)
+{
+	CUSBBluetoothDevice *pThis = (CUSBBluetoothDevice *) pContext;
+	assert (pThis != 0);
+
+	pThis->DataCompletionRoutine (pURB);
+}
